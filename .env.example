# Variables de FieldOps, avec leurs valeurs par défaut. Aucune n'est obligatoire.
#
# Avec docker compose : un fichier .env à la racine n'est lu que pour
# API_PORT et POSTGRES_PORT (ports publiés sur la machine). Les variables de
# l'API dans le conteneur sont fixées par docker-compose.yml.
API_PORT=3000
POSTGRES_PORT=5432

# API lancée hors Docker (pnpm --filter api start) : l'API ne lit pas de
# fichier .env, ces variables sont à exporter dans le shell. Sans elles, les
# valeurs ci-dessous s'appliquent ; elles visent le PostgreSQL de docker compose.
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=fieldops
DATABASE_PASSWORD=fieldops
DATABASE_NAME=fieldops
