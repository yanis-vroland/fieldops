# Variables de l'API (apps/api). Toutes facultatives : sans elles, l'API
# utilise ces valeurs par défaut, qui correspondent à docker-compose.yml.
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=fieldops
DATABASE_PASSWORD=fieldops
DATABASE_NAME=fieldops

# Ports publiés sur la machine par docker compose.
API_PORT=3000
POSTGRES_PORT=5432
